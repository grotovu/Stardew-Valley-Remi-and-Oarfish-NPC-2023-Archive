	"npca.oarfish.dialogue.companion_Club": "...$s #$e#... #$b#%Oarfish warns you to gamble responsibly",

	"npca.oarfish.dialogue.companion_Desert": "...$a #$b#%Oarfish is squinting her eyes at the desert sun.",
	"npca.oarfish.dialogue.companion_Desert_Night": "...$7 #$b#%Oarfish seems relieved that it's nighttime in the desert.",

