	"npca.oarfish.dialogue.companion_Farm": "...$7 #$b#%Oarfish seems to enjoy sightseeing at your farm.",
	"npca.oarfish.dialogue.companion_Farm_Spouse": "...!$h #$b#%Oarfish is happy to be at home.",

	"npca.oarfish.dialogue.companion_FarmHouse": "...!$h #$b#%Oarfish is honored to be welcomed into your home.",
	"npca.oarfish.dialogue.companion_FarmHouse_Spouse": "...$l #$b#%Oarfish is honored to be living with you.",

	"npca.oarfish.dialogue.companion_FishShop": "...$7 #$b#%Oarfish leisurely watched the living baits in captivity.",
	"npca.oarfish.dialogue.companion_FishShop~1": "...$7 #$b#%Oarfish seems to be interested at the various hooks and bobbers.",

	"npca.oarfish.dialogue.companion_MermaidHouse": "...$l #$b#%Oarfish seems to be moved to tears at the performance.",

	"npca.oarfish.dialogue.companion_Mine": "...!$h #$b#%Oarfish seems excited.",
    "npca.oarfish.dialogue.companion_Mine~1": "...!$a #$b#%Oarfish readies her sword.",
    "npca.oarfish.dialogue.companion_Mine~2": "...$7 #$b#%Oarfish vows to protect you.",
	"npca.oarfish.dialogue.companion_Mine~3": "!!$u #$e#.....$a #$b#%Oarfish is determined to protect you.",

	"npca.oarfish.dialogue.companion_QiNutRoom": "... #$b#%Oarfish is eyeing the man with suspicion. #$e#... #$b#...$7 #$b#%Oarfish gestured there's nothing to worry about.",
	"npca.oarfish.dialogue.companion_QiNutRoom~1": "...$a #$b#%Oarfish seems frustrated at the challenges list. #$b#%Get 50,000 points in Junimo Kart Endless Mode... yikes.",

