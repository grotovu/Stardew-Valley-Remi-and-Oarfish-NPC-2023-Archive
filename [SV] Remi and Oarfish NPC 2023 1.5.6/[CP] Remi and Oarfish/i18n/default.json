	// Remi Divorce Dialogue
	"CUSTOM.remi.WipedMemory": "Huh? Hmm... I don't know you.$6",
	"CUSTOM.remi.Divorced_bouquet": "...you smell awful.$6",
	"CUSTOM.remi.Divorced_gift": "...Nah, don't want it.$7",


	// Remi Movie Invite
	"CUSTOM.remi.InvitedBySomeoneElse": "Um, sorry. But I already got handed a ticket by someone else.#$b#...Not sure how I'll be entertained by the movie itself, though.$7",
	"CUSTOM.remi.AlreadySeen": "Hey, I went to this before.#$b#...Still don't know that the movie's about, though.$6",
	"CUSTOM.remi.MovieInvite_Invited": "Huh? You know I'm deaf-blind right?$6#$b#Well, why the heck not. I'll go with you.",
