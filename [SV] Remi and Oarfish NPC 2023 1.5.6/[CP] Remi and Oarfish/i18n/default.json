// 8 Hearts
	"DIALOGUE.oarfish.8Hearts.spring.monday": "...$7#$b#%Oarfish waves hello at you.#$e#...?$7#$b#%She wonders about how your week went.",
	"DIALOGUE.oarfish.8Hearts.spring.tuesday": "...$7#$b#%Oarfish smiles and silently greets you.#$e#...$7#$b#%She seems to be admiring the ocean waves this spring.",
	"DIALOGUE.oarfish.8Hearts.spring.wednesday": "...$7#$b#%Oarfish seems to enjoy your company.#$e#...!$h",
	"DIALOGUE.oarfish.8Hearts.spring.friday": "...$7#$b#%Oarfish acknowledes your presence.",
	"DIALOGUE.oarfish.8Hearts.spring.saturday": "...$a#$b#%Oarfish looks determined. Perhaps she's looking forward to hitting the arcades tonight?#$e#...$a#$b#%You wonder if she'll finally beat the game...",

	"DIALOGUE.oarfish.8Hearts.summer.monday": "...$7#$b#%Oarfish waves hello at you. Afterwards she resumes fanning herself with a palm leaf.",
	"DIALOGUE.oarfish.8Hearts.summer.tuesday": "...$7#$b#%Oarfish smiles and silently greets you.#$e#...?$7#$b#%She wonders if you're up for a swim in the ocean.",
	"DIALOGUE.oarfish.8Hearts.summer.wednesday": "...$u#$b#%Oarfish seems concerned. She points at some of your burnt skin.#$e#...$s",
	"DIALOGUE.oarfish.8Hearts.summer.friday": "...#$b#%Oarfish is fanning herself. She has her mining gear closeby.#$e#...$7#$b#%Perhaps a good way to escape the summer heat is to dive into the underground.",
	"DIALOGUE.oarfish.8Hearts.summer.saturday": "...$h#$b#%Oarfish seems very happy today. She's holding what seems to be a beautiful shell in her hands.",

	"DIALOGUE.oarfish.8Hearts.fall.monday": "...$7#$b#%Oarfish waves hello at you.",
	"DIALOGUE.oarfish.8Hearts.fall.tuesday": "...#$b#%Oarfish seems to be holding a torn piece of Remi's coat... you wonder what happened.#$e#...$7#$b#%Oarfish assures you that Remi is okay.",
	"DIALOGUE.oarfish.8Hearts.fall.wednesday": "...$7#$b#%She seems to enjoy your company.#$e#...!$h",
	"DIALOGUE.oarfish.8Hearts.fall.friday": "...!$u#$b#%Oarfish points behind you with a wary look on her face.#$e#...!$8#$b#%It appears she was just trying to scare you...",
	"DIALOGUE.oarfish.8Hearts.fall.saturday": "...$s#$b#%Oarfish seems sad today...#$e#...$s#$b#...?$l#$b#%She looks at you and smiles. But a moment after she frowns again.#$e#...$s",

	"DIALOGUE.oarfish.8Hearts.winter.monday": "...!!$u#$b#%Oarfish sneezed.#$e#...#$b#...?$7",
	"DIALOGUE.oarfish.8Hearts.winter.tuesday": "...#$b#%Oarfish brushes snow off her shoulders.#$e#...?$7",
	"DIALOGUE.oarfish.8Hearts.winter.wednesday": "...$7#$b#%She seems to enjoy your company.#$e#...!$h",
	"DIALOGUE.oarfish.8Hearts.winter.friday": "...$7#$b#%Oarfish has her mining gear out. Winter really is a good season to take on the mines.#$e#...$l#$b#%Oarfish reminds you to be careful.",
	"DIALOGUE.oarfish.8Hearts.winter.saturday": "...$s#$b#%Oarfish seems to be holding something small... it's shivering!#$e#...?$l#$b#%It was a small, drenched animal. Perhaps it fell in the frozen waters?",


